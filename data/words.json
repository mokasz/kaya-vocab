  "story": {
    "day": 108,
    "title": "Kaya's Afternoon Walk",
    "sentences": [
      "Fourteen-year-old Kaya left junior high school.",
      "Her orchestra director spoke loudly about their instruments for the musical.",
      "It was a custom to buy a new shirt.",
      "The weather was good outside in the central city.",
      "She walked straight along the street, past a bank and court.",
      "A police officer stood near a nursing home on the corner.",
      "She hoped to buy an olive green one, which was tricky.",
      "She used her tablet to check online prices for shopping.",
      "\"Yeah, this is it!\" she thought, then she bought it.",
      "She got a snack, hoping her phone would not die.",
      "Her homework was a small battle, but no problem to give her.",
      "She would cut her paper and wait, enjoying the smell."
    ]
  }
