  "story": {
    "day": 33,
    "title": "Kaya's Saturday Call",
    "sentences": [
      "Kaya was a student.",
      "It was a good Saturday in November.",
      "She studied English with her dictionary.",
      "Her radio played soft music.",
      "Kaya saw a picture of New York and wanted to visit the UK, too.",
      "A purple violet lay on her desk.",
      "Her telephone rang. \"Pardon?\"",
      "\"That chef's soup was sweet and sour,\" her friend said.",
      "They made plans for Sunday.",
      "Kaya wrote a message on a card with chalk."
    ]
  }
