  "story": {
    "day": 166,
    "title": "A Rainy Afternoon Visit",
    "sentences": [
      "It was a very rainy afternoon.",
      "Kaya certainly felt tired after school.",
      "She spent some quiet time reading.",
      "Then she began to think about her friend.",
      "Her friend, Hana, was Kaya's age.",
      "Kaya remembered Hana's words: \"You'll come over!\"",
      "\"We'll have a quick snack,\" Kaya decided.",
      "She put water on to heat for tea.",
      "The doorbell began to ring.",
      "\"She'll be here now!\" Kaya thought happily.",
      "\"They'll have fun!\" she looked forward to it.",
      "She mustn't let the water boil; it won't be good."
    ]
  }
