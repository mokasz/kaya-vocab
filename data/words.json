  "story": {
    "day": 48,
    "title": "Kaya's Busy Sunday",
    "sentences": [
      "It was a great day for Kaya.",
      "This year, she was twelve.",
      "Every week, Kaya knew what to do.",
      "She liked to study English much.",
      "Kaya used her dictionary to speak better.",
      "After lunch, she started piano practice.",
      "Her dad played drum with her.",
      "Her aunt played trumpet.",
      "\"That's a great sound!\" her grandfather said.",
      "Then they went to the park.",
      "Kaya liked tennis, but not soccer.",
      "\"I don't like basketball; I am tired,\" she told her dad."
    ]
  }
