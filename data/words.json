  "story": {
    "day": 61,
    "title": "Kaya's Saturday Plans",
    "sentences": [
      "It was a lovely Saturday.",
      "Kaya didn't get up early.",
      "She played a video game until noon.",
      "Later, she watched an interesting program.",
      "It showed tall, beautiful places in Mexico.",
      "Kaya wanted to speak Spanish there.",
      "She didn't cook much for lunch.",
      "In the afternoon, she made a video call.",
      "Her friend asked, \"Aren't we going to the movie theater?\"",
      "Kaya had a short time off from vacation.",
      "She would listen to great Christmas music at night.",
      "She wanted to play tennis or soccer until the end."
    ]
  }
}