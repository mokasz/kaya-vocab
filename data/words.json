  "story": {
    "day": 125,
    "title": "Kaya's Busy Morning",
    "sentences": [
      "Kaya went to the department store for shorts.",
      "She was a member of a volunteer group.",
      "She remembered her journey to Alaska one year ago.",
      "Kaya did help at a nursing home there.",
      "She didn't forget that country's culture.",
      "Kaya carried her own smartphone and olive note.",
      "However, half an hour ago, she drank barley tea.",
      "She heard the sound of a plane flying off.",
      "Kaya dropped her phone near a skate park.",
      "She looked for it, worried about losing it.",
      "Finally, a police officer found it back.",
      "He told an interviewer about selling coffee on the fourteenth floor; everybody shared laughter in the setting; no one was in the hospital."
    ]
  }
