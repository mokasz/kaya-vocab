  "story": {
    "day": 84,
    "title": "Kaya's Busy Saturday",
    "sentences": [
      "Kaya left her bed early one Saturday in December.",
      "The excited girl took eggs and fish to make in the kitchen.",
      "Most people there talked about their favorite American sandwich.",
      "Four or five other students played the guitar in her house.",
      "Second, they played table tennis near a deep river.",
      "They talked about an interesting art project from autumn.",
      "Kaya drew it on a board with three pieces of chalk.",
      "Her fifth or sixth dictionary was from a local store.",
      "After that, she used a computer for an interview.",
      "She wore shorts and read about an old custom.",
      "The seventh, eighth, ninth, tenth, and eleventh pages had zero errors.",
      "She said, \"Wow, there are twelve hundred or a thousand books!\""
    ]
  }
}