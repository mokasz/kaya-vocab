  "story": {
    "day": 1,
    "title": "Kaya's Afternoon Thoughts",
    "sentences": [
      "Kaya sat on her chair on Wednesday.",
      "She saw brown autumn leaves in her garden tree from the window.",
      "Kaya ate an apple and heard music on the radio.",
      "A picture of a yellow boat hung by her bed.",
      "She remembered playing guitar last summer.",
      "School was sometimes difficult, especially in November.",
      "The blackboard problems after the bus ride were hard.",
      "Winter and January brought snow and an umbrella.",
      "Kaya checked her watch on her phone.",
      "\"Time to dream,\" she thought."
    ]
