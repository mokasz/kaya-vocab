  "story": {
    "day": 116,
    "title": "A Kind Act at School",
    "sentences": [
      "It was a warm June day.",
      "Kaya was early for her last class.",
      "She carried her history report.",
      "Yesterday, she worried about a wrong exam answer.",
      "By the school court, an elderly man dropped his towel.",
      "Kaya ran to bring it back. \"Is this yours?\" she asked.",
      "Kaya was careful not to cut the fabric.",
      "A sweet smell was around her path.",
      "This kind way belonged to her country's culture.",
      "It was a good rule for the whole world.",
      "She finished her good deed a moment ago.",
      "Mrs. Tanaka would need a number from her."
    ]
  }
