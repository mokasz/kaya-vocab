  "story": {
    "day": 40,
    "title": "Kaya's Saturday Afternoon",
    "sentences": [
      "It was a cold Saturday in February.",
      "Kaya was helping her mother.",
      "They were cooking delicious soup.",
      "Her mother used a big recipe book.",
      "It had a nice picture.",
      "\"What are these vegetables?\" Kaya asked.",
      "She finished her English and math homework.",
      "Her classmates are her good friends.",
      "Ms. Sato teaches science. She's a kind teacher.",
      "Her father, a pilot, was flying. He's coming home on his bus.",
      "\"My mother is a nurse,\" Kaya said.",
      "Next, they would visit the movie theater."
    ]
  }
