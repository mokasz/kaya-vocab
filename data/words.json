  "story": {
    "day": 30,
    "title": "Kaya's Thursday Dream",
    "sentences": [
      "It was a cold winter day, minus five degrees.",
      "Kaya looked out her window.",
      "She had a lovely, old picture of New York.",
      "Her dream was to visit America next year.",
      "On Thursday, she ate hot salmon soup.",
      "She also had a purple apple.",
      "\"Pardon me, Kaya, that's your telephone!\" her mom said.",
      "It was a video call from Finland.",
      "\"Thank you for calling,\" she said here.",
      "Her job was to practice English."
    ]
  }
