  "story": {
    "day": 140,
    "title": "Kaya's Snowy Festival Day",
    "sentences": [
      "Kaya was a volunteer last Saturday.",
      "The date was February 10th.",
      "She helped at a public amusement park festival.",
      "The park was far from her home.",
      "Kaya took a plane and stayed at a hotel.",
      "The morning was sunny, but it grew cloudy.",
      "A minute later, rain started, turning rainy.",
      "Then it began to snow, becoming dark and snowy.",
      "Kaya wasn't happy about the weather.",
      "Many people were absent, and Kaya felt very tired.",
      "She had to carry heavy comic boxes.",
      "At 6 p.m., she saw a concert in a studio."
    ]
  }
}