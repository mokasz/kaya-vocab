  "story": {
    "day": 41,
    "title": "Kaya's Lunch Time",
    "sentences": [
      "It was a sunny day in February.",
      "Kaya, a young girl, felt very hungry.",
      "She opened her new lunchbox for lunch.",
      "Inside were rice and a small, short radish.",
      "There was also a long piece of eggplant.",
      "And some delicious hot soup.",
      "A boy next to her looked.",
      "\"What's that amazing recipe?\" he asked.",
      "Kaya did not think his lunch looked bad.",
      "She remembered a video about New York and Paris.",
      "A Tall man, her teacher, walked by.",
      "\"Pardon me,\" he said. \"Now it's high time.\""
    ]
  }
}