  "story": {
    "day": 1,
    "title": "Kaya's Memory Box",
    "sentences": [
      "Kaya sat at her brown desk on a rainy Monday.",
      "She found a picture of a lion and a yellow doll.",
      "Then, she looked at the calendar on the door.",
      "She saw months from January to June in her notebook.",
      "In March, she played the guitar under a green tree.",
      "After that, she saw many red and orange autumn leaves in November.",
      "Finally, she remembered a blue radio in December.",
      "The winter was cold, so she stayed home because it was Sunday.",
      "Her phone showed the time, but she checked her watch.",
      "Kaya loved every day from February to Wednesday in summer."
    ]
  }
