  "story": {
    "day": 157,
    "title": "Kaya's Saturday Adventure",
    "sentences": [
      "Last Saturday, Kaya had a busy morning.",
      "First, she went to her calligraphy class.",
      "Her teacher praised her beautiful brushstrokes.",
      "Then, she joined her friends for moral education.",
      "They talked about helping others.",
      "After that, Kaya met her dad.",
      "They went fishing near the river.",
      "Kaya tried to catch a big fish.",
      "Later, they enjoyed hiking on a small mountain.",
      "Kaya loved the fresh air.",
      "Finally, they drank refreshing lemonade at home.",
      "It was quite a fun day!"
    ]
  }
