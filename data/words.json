  "story": {
    "day": 106,
    "title": "Kaya's Special Shopping Day",
    "sentences": [
      "It was Thursday, the twenty-first.",
      "Kaya woke at 7 a.m. to go out.",
      "Her elderly grandpa was in the hospital.",
      "She visited a department store's sixtieth anniversary sale.",
      "It offered seventy percent off items on the fourth floor.",
      "Kaya usually bought medicine, but chose a different video game.",
      "It was nineteen dollars, with a fifteenth-dollar discount.",
      "She also grabbed cool shorts and an iced tea.",
      "Kaya sent a message and a note: \"Join us for dinner soon!\"",
      "Dinner was planned for the fourteenth.",
      "She hoped he would hold it and not worry about it.",
      "A member told an interviewer about the eighteenth, fiftieth, seventeenth song.",
      "No one else could skate in the court."
    ]
  }
