  "story": {
    "day": 171,
    "title": "Kaya's Rainy Shopping",
    "sentences": [
      "It was a rainy afternoon, so Kaya went to the shop with her mom.",
      "They needed ingredients for dinner tonight.",
      "\"We have forty minutes until the shop bell rings,\" her mom said.",
      "Kaya felt quite excited.",
      "She was looking forward to new snacks.",
      "\"You'll choose a good one!\" Mom smiled.",
      "Her mom also needed items for research.",
      "\"We'll buy them next,\" she told Kaya.",
      "\"She'll call Dad,\" Kaya thought.",
      "They mustn't forget the heat pack.",
      "\"They'll certainly enjoy dinner,\" Mom added.",
      "\"We won't get wet,\" Kaya hoped."
    ]
  }
