  "story": {
    "day": 143,
    "title": "Kaya's Special Dinner",
    "sentences": [
      "Yesterday, Kaya felt warm.",
      "She had a slight fever.",
      "Her mom gave her lemonade.",
      "Kaya drank it.",
      "Their plan was a big dinner on the fourteenth.",
      "Kaya went to the department store to shop.",
      "She needed a roast chicken.",
      "She had only enough money.",
      "Her neighbor sent greetings.",
      "Kaya was not scared.",
      "She bought the chicken safely.",
      "Kaya thought about Hawaii.",
      "\"A million dreams!\" she whispered.",
      "She would pack the day after tomorrow.",
      "Then, she helped turn off the lights."
    ]
