  "story": {
    "day": 107,
    "title": "Kaya's Busy Plan",
    "sentences": [
      "Kaya sat on the sofa in her living room.",
      "She saw a message on the blackboard.",
      "It was for the dance club's eightieth anniversary.",
      "Kaya wore jeans and a new cap.",
      "She needed to write an email on her computer.",
      "The club had thirty members; the ninetieth person would visit today!",
      "Her friend once was in the hospital on the ninth floor.",
      "Kaya was ready to join a park cleanup soon. She put her jogging suit out.",
      "They would pick up litter at the court on thirtieth street.",
      "She hoped to hold the thousandth piece of trash, then lie down between chores.",
      "After a bath, she would eat cake and sleep.",
      "Kaya dreamt of skiing and skating; her hundredth dollar was almost saved."
    ]
  }
}