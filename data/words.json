  "story": {
    "day": 21,
    "title": "Kaya's Big Trip",
    "sentences": [
      "Kaya always sat by the window every Tuesday and Thursday.",
      "She studied about the UK in November and December.",
      "Last February, she bought a pink chair and a white desk.",
      "She used a thick dictionary to learn many new words.",
      "She put a violet ribbon in her long hair.",
      "\"Look, there is a small bell on my ear.\"",
      "On Friday, she received a call on the old telephone.",
      "Kaya took a fast train and then a big boat.",
      "\"Please watch my bag,\" Kaya said to her mother.",
      "She checked her new watch in the sun in July."
    ]
  }
