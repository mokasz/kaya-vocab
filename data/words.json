  "story": {
    "day": 45,
    "title": "Kaya's New Year's Day",
    "sentences": [
      "It was New Year's Day.",
      "Kaya's mother cooked many dishes for her family.",
      "Her uncle, a busy office worker, came from Hong Kong.",
      "Kaya was a smart girl, but a little shy.",
      "She's really interested in science.",
      "Her young cousin had short, dark hair.",
      "He came from elementary school.",
      "He was very friendly and made a funny face.",
      "He wanted to play with Kaya's brother.",
      "Mom put fruit and a beautiful dish on the table.",
      "Later, they all walked to the temple.",
      "It was a great day. Kaya said, \"Uh-huh!\""
    ]
  }
}