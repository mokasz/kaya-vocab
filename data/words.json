  "story": {
    "day": 28,
    "title": "A Wednesday Afternoon",
    "sentences": [
      "It was a lovely Wednesday in March.",
      "Kaya opened her locker, taking her old gray umbrella.",
      "Winter was finally over this year.",
      "Her friend Ami was waiting here.",
      "They looked out the window at the green garden.",
      "\"Let's get some Japanese food now!\" Ami said.",
      "Kaya's favorite was an apple.",
      "\"Pardon? That's okay! Thank you!\" Kaya replied.",
      "Then they planned a video call by telephone."
    ]
  }
