  "story": {
    "day": 36,
    "title": "Kaya's Saturday Morning Dreams",
    "sentences": [
      "It was a cold winter Saturday morning.",
      "Kaya got out of bed.",
      "She sat at her desk.",
      "Kaya liked drawing pictures.",
      "She drew a purple tree.",
      "Next, she watched a video about world cities.",
      "She saw Paris, New York, Sydney, and Hong Kong.",
      "Kaya thought, \"I am an office worker.\"",
      "\"Pardon?\" her mother called.",
      "\"That's okay,\" Kaya replied.",
      "Everyone wants to start a good year.",
      "Kaya remembered Wednesday's delicious Japanese lunch."
    ]
  }
}