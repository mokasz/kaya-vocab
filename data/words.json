  "story": {
    "day": 17,
    "title": "Kaya's School Day",
    "sentences": [
      "It was a bright Friday morning at school.",
      "Kaya looked at the big blackboard.",
      "There was a picture of a white tree.",
      "A red apple hung there, and a yellow flower.",
      "A purple butterfly flew near the window.",
      "Kaya touched her nose. Her name was Kaya.",
      "She checked her watch. It was April, a beautiful spring month.",
      "She remembered fall in October.",
      "On Wednesday, she drew a map. She used it on Thursday.",
      "Kaya took her umbrella for Saturday. On Sunday, she listened to the radio."
    ]
  }
