  "story": {
    "day": 50,
    "title": "Kaya's Saturday Morning",
    "sentences": [
      "Kaya woke up on a lovely Saturday morning.",
      "After breakfast, she wanted to play soccer.",
      "But her brother, Ren, didn't want to play much.",
      "He liked basketball and tennis practice.",
      "Kaya knew he was smart, but a little shy.",
      "She had a good day of study planned.",
      "Kaya dreamed of being a chef in Beijing.",
      "She wanted to speak English there.",
      "Their aunt had a wedding next week.",
      "Ren showed Kaya his funny toy airplane.",
      "He said, \"We aren't going to South Korea!\"",
      "It would be a great day for them."
    ]
  }
}