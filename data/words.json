  "story": {
    "day": 40,
    "title": "Kaya's Lunchtime Dream",
    "sentences": [
      "It was lunch time at school.",
      "Kaya opened her big lunchbox.",
      "She had eggplant, radish, and soup.",
      "Her tall classmate, Ken, sat next.",
      "Ken was her good friend, a boy.",
      "\"Hey, Kaya, what's in your recipe book?\" he asked.",
      "Kaya showed him her book.",
      "His eye caught a big movie theater picture.",
      "Last January, I found this London recipe.",
      "A red telephone booth was also there.",
      "\"No, not for lunch now!\" she laughed.",
      "Her father, a doctor, would visit next February."
    ]
  }
}