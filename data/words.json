  "story": {
    "day": 82,
    "title": "Kaya's Festival Day",
    "sentences": [
      "Kaya, twelve, and her brother, thirteen, went to a festival.",
      "Many different stalls sold ninety colorful pens.",
      "Most visitors drank iced tea from a cup as they walked.",
      "A baseball player, their captain, offered hot soup.",
      "He shared a word about his eighty-year-old coach.",
      "The coach made a deal for fourteen young players.",
      "A Hindu god statue stood on the floor.",
      "It was theirs, a wedding gift from India.",
      "Kaya bought delicious meat and an eighth Christmas ornament.",
      "The festival was a kilometer from a lake and river.",
      "Sixty children and fifty adults came from a beach seventy miles away.",
      "Kaya, the twelfth, saw the ninth, tenth, and eleventh prizes."
    ]
  }
