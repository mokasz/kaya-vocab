  "story": {
    "day": 151,
    "title": "Kaya's Camp Memories",
    "sentences": [
      "Yesterday, Kaya arrived home from camp.",
      "She was very tired and thirsty.",
      "Her neighbor volunteered; he wasn't absent but had a fever.",
      "Kaya ate a warm meal safely.",
      "She saw a popular star appear tonight.",
      "Forty new greetings were important.",
      "Kaya used her hand and finger to read.",
      "She did research about wolves. They weren't scared.",
      "Her head, neck, shoulder, arm felt stiff.",
      "Her leg, knee, foot, face also ached after the climb.",
      "Finally, she turned off her lamp to stay in bed.",
      "Kaya remembered the fourteenth bright million stars."
    ]
  }
}