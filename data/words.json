  "story": {
    "day": 22,
    "title": "A Day at the Movie Theater",
    "sentences": [
      "Last Saturday, Kaya waited at a movie theater in Japan.",
      "She sat on a violet chair with a purple notebook.",
      "First, Kaya wrote ten minus two in the notebook.",
      "Next, she drew a picture of Mr. Smith.",
      "Then, a kind woman walked over with a boy.",
      "The woman said, \"Hi, please meet Tom.\"",
      "\"You're Kaya, so can you teach me English?\" Tom asked.",
      "Kaya smiled and taught him May, August, and September.",
      "Finally, she wrote October, November, and December for him."
    ]
  }
