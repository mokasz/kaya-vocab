  "story": {
    "day": 43,
    "title": "Kaya's Market Day",
    "sentences": [
      "It was a sunny Saturday.",
      "Kaya and her uncle went to the market.",
      "They saw a very high building there.",
      "Everyone was busy walking around.",
      "A kind lady with white hair smiled.",
      "She sold fruit or vegetables.",
      "\"Oh, that radish looks delicious!\" Kaya said.",
      "\"Hey, who's on that low stool?\" she asked.",
      "Kaya remembered her family once visited Paris.",
      "Or was it Sydney? It felt difficult to remember right.",
      "She wanted to see a new temple for New Year's Day.",
      "\"Uh-huh, no P.E., just fun!\" she really thought."
    ]
  }
}