  "story": {
    "day": 141,
    "title": "Kaya's Snowy Day Out",
    "sentences": [
      "Kaya woke up. It was a cloudy morning.",
      "Her friend, Yuki, was absent from their plan.",
      "Kaya took the public bus. It took half an hour.",
      "She arrived at a small festival near a hotel.",
      "It became very windy. Soon, some rain started.",
      "It was a rainy afternoon. Kaya felt tired.",
      "She drank warm tea and ate an olive cracker.",
      "The sky grew dark. Then, snow began to fall.",
      "It was a beautiful snowy evening. She felt brave.",
      "She spent a happy hour watching a small concert.",
      "She read an important sign about cancer for a minute.",
      "Kaya wanted to tell Yuki about the amusement park nearby."
    ]
  }
}