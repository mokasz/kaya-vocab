  "story": {
    "day": 18,
    "title": "Kaya's Dream of Australia",
    "sentences": [
      "Kaya woke up in her bed on Friday morning.",
      "She remembered her summer trip to Australia last December.",
      "She saw a white boat on the blue sea.",
      "A green garden grew there with many plants.",
      "Her friend had long brown hair and a happy face.",
      "A yellow flower touched Kaya's ear gently.",
      "Kaya then sat at her desk in a comfortable chair.",
      "She looked at the door, touching her nose and mouth.",
      "Her big question was about going back soon.",
      "\"Maybe in January, February, March, October, or November?\" she thought."
    ]
  }
