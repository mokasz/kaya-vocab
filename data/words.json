  "story": {
    "day": 165,
    "title": "Kaya's Lunchtime",
    "sentences": [
      "Kaya opened her bento for lunch.",
      "Today she had yummy curry.",
      "Her friend, Hana, had spaghetti.",
      "Kaya asked to borrow some.",
      "Hana smiled and moved her plate forward.",
      "She said it was \"of course\" okay.",
      "Kaya ate a small piece of lettuce.",
      "She saw Hana's pretty ring.",
      "Kaya thought it'll be a good lunch.",
      "Hana said, \"We'll finish fast.\"",
      "She added, \"You won't be late.\"",
      "Kaya knew they'll both be ready; she'll hurry."
    ]
  }
