  "story": {
    "day": 27,
    "title": "A Special Saturday in Spring",
    "sentences": [
      "It was a warm spring Saturday morning.",
      "Kaya and her sister went to the supermarket.",
      "They bought a big apple for Mr. Tanaka.",
      "Everyone was here near the big window.",
      "Kaya sat on a chair and fixed her hair.",
      "\"Pardon? The guitar isn't in the locker,\" Kaya said.",
      "\"It's okay, let's start the music,\" her sister said.",
      "They used the telephone to find a cookie recipe.",
      "\"Thank you, you're a good friend,\" everyone said.",
      "Kaya smiled because it was a wonderful day."
    ]
  }
