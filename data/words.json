  "story": {
    "day": 49,
    "title": "Kaya's Spring Party",
    "sentences": [
      "It was a lovely spring day.",
      "Kaya's grandmother was busy, wanting to have a great party.",
      "Kaya went to the supermarket.",
      "She bought many radishes and salmon.",
      "Grandfather had a job using his tool.",
      "\"Hey, are you hungry?\" he asked.",
      "\"No, we aren't, thank you!\" Kaya said.",
      "They made yummy American sandwiches and Kaya's favorite candy.",
      "About everyone came at noon.",
      "There was a small temple nearby.",
      "Everyone asked how the party was.",
      "It was really fun."
    ]
  }
}