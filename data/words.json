  "story": {
    "day": 59,
    "title": "Kaya's EIKEN Study Day",
    "sentences": [
      "Today, Kaya went to the library near her school.",
      "She wanted to pass her EIKEN test.",
      "Kaya needed to study science words.",
      "Her mother, her study boss, helped teach her.",
      "They looked at those difficult words inside a book.",
      "Kaya dreamed of visiting London, Finland, or the U.S.",
      "She felt okay; she would never cry.",
      "When they finished, they ate dinner.",
      "Her mother prepared avocado and seaweed for us.",
      "Kaya, in her favorite T-shirt, helped wash dishes.",
      "\"They're so tasty! She's a great cook,\" Kaya said.",
      "She knew where more English words were, always."
    ]
  }
}