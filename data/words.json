  "story": {
    "day": 15,
    "title": "Kaya's Quiet Sunday",
    "sentences": [
      "It was a quiet Sunday morning.",
      "Kaya got out of bed and looked at her calendar.",
      "She remembered autumn with brown and yellow leaves on a tree.",
      "Her favorite picture showed a boat on a green lake.",
      "Planning trips was often difficult.",
      "She checked her watch and sat on a chair.",
      "Her phone rang, \"Hello, it's Tuesday.\"",
      "They talked about her aunt's garden for Wednesday, or taking the bus.",
      "Kaya imagined purple flowers, then listened to the radio.",
      "She thought about January, February, March, May, June, November."
    ]
  }
