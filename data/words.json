  "story": {
    "day": 93,
    "title": "Kaya's Museum Adventure",
    "sentences": [
      "Kaya was ready for her museum trip.",
      "She wore a different shirt and a cap.",
      "They walked down Ninetieth Street.",
      "A blackboard showed the custom history story.",
      "Kaya would read all the facts.",
      "\"Whose photo is this animal's tail?\" she asked.",
      "The ninth exhibit had thirty items.",
      "Later, Italian cream pasta was fortieth on the menu.",
      "\"Sorry, we can't order roast beef again,\" Mom said.",
      "Kaya had to change her choice for the twentieth plate.",
      "\"Excuse me, are you sure about the thirteenth towel?\" she asked.",
      "She would like to dance there someday on the twenty-second."
    ]
  }
