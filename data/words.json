  "story": {
    "day": 44,
    "title": "A Saturday at Grandma's",
    "sentences": [
      "It was Saturday at Kaya's grandparents' house.",
      "Her dad and aunt were there.",
      "Grandmother showed their wedding picture.",
      "Grandfather had white hair then.",
      "The photo showed everyone, minus Uncle Ken.",
      "\"Hey, is this your father?\" Kaya asked.",
      "He's a kind office worker now.",
      "They discussed English, math, and so on.",
      "Kaya saw an old toy on a high shelf.",
      "It was a kind of measuring tool.",
      "It was from their Finland and Hong Kong trip.",
      "\"Aren't those memories okay?\" everyone asked."
    ]
  }
}