  "story": {
    "day": 20,
    "title": "Kaya's Monday Morning",
    "sentences": [
      "It was a cold Monday morning in October.",
      "Kaya stood near her desk and picked up a white eraser.",
      "Her yellow notebook and an English dictionary were on the bed.",
      "\"Are you ready?\" Mr. Suzuki asked on the telephone.",
      "No, Kaya was not ready because her dog had her watch.",
      "The dog had short hair and a black nose.",
      "Kaya had to call her friend to talk about Australia.",
      "She saw a big boat and a TV in her textbook.",
      "\"This is a great picture,\" Kaya said.",
      "She always studied hard for her dreams."
    ]
  }
