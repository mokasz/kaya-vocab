  "story": {
    "day": 80,
    "title": "Kaya's Shopping Trip",
    "sentences": [
      "In two thousand twenty-two, Kaya had social studies.",
      "She was a young student; her parent had to work.",
      "Before her track and field practice, she went to the library.",
      "Kaya played table tennis for thirty minutes.",
      "She needed a new hat. Its size was forty inches.",
      "\"Doesn't this hat look bad?\" she asked her parent.",
      "We looked at twenty hats. Her old one was hers.",
      "We found one for twenty-one dollars. It was ours.",
      "\"How about these?\" her parent asked, showing them two.",
      "Kaya didn't know if she had any money for candy.",
      "A little bird flew high past them as we left the restaurant.",
      "\"We're home now! Welcome! On the table, just for you. Bathe your feet.\""
    ]
  }
