  "story": {
    "day": 48,
    "title": "A November Evening with Aunt",
    "sentences": [
      "Kaya was a student.",
      "It was a cold November afternoon.",
      "She visited her kind aunt, a lady.",
      "They cooked a new radish soup dish.",
      "\"This isn't from the UK,\" her aunt said.",
      "It was a special recipe from Paris.",
      "Kaya's grandfather liked that soup, too.",
      "Her dad was a busy office worker man.",
      "He worked in a low building all day long.",
      "Kaya saw a pretty violet card.",
      "\"I'm sure it's not bad!\" she thought.",
      "Yes, they talked about so on."
    ]
  }
}