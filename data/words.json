  "story": {
    "day": 16,
    "title": "Kaya's Daydream",
    "sentences": [
      "Kaya sat quietly at her desk on a warm September day.",
      "She looked out the door at the blue sky.",
      "Her teacher used white chalk on the black board.",
      "Kaya had long black hair and bright eyes.",
      "Her nose twitched, so she used her dictionary.",
      "She heard a train with her ear.",
      "\"Is Canada fun?\" she asked, closing her mouth.",
      "She remembered biking last August or October.",
      "Then she thought of America, Australia, and China.",
      "Her gray dress felt comfortable in December and July."
    ]
  }
