  "story": {
    "day": 19,
    "title": "A Busy Thursday at Home",
    "sentences": [
      "Last Thursday, the sun was bright outside the window.",
      "Kaya sat at her desk with a gray computer.",
      "She looked at a purple album and a brown dictionary.",
      "The English homework was difficult, so she called Mr. Smith.",
      "Her dog had gray hair and big, black eyes.",
      "It opened its mouth and looked at her on Wednesday.",
      "Next, Kaya played her violin because she had no lessons.",
      "She checked her watch because it was almost time for dinner.",
      "Finally, she finished everything before her busy Saturday in January.",
      "\"I did a good job today,\" she said with a smile."
    ]
  }
